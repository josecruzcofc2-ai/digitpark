{
  "rules": {
    // AUDIT-FIXED [2026-03-10] B-04/B-05: Reglas de seguridad para Firebase Realtime Database
    // Copiar este contenido al panel de Rules en Firebase Console:
    // https://console.firebase.google.com/project/digitpark-7d772/database/rules

    "players": {
      "$uid": {
        // B0-B [2026-03-20]: Cualquier usuario autenticado puede leer perfiles
        // (necesario para búsqueda de jugadores, perfiles de amigos, participantes de torneo)
        // Datos sensibles de pago están en Stripe/Triumph, no aquí.
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "leaderboards": {
      // Cualquier usuario autenticado puede leer leaderboards
      ".read": "auth != null",

      "global": {
        "$gameId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['userId', 'username', 'time', 'countryCode', 'validationToken']) && newData.child('userId').val() === auth.uid && newData.child('time').isNumber()"
          }
        }
      },

      "country": {
        "$countryCode": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['userId', 'username', 'time', 'countryCode', 'validationToken']) && newData.child('userId').val() === auth.uid && newData.child('time').isNumber()"
          }
        }
      }
    },

    "scores": {
      "$uid": {
        // Solo el usuario puede leer/escribir su historial de scores
        ".read": "auth != null && auth.uid === $uid",
        "$scoreId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['userId', 'time', 'timestamp'])"
        }
      }
    },

    "tournaments": {
      // Cualquier usuario autenticado puede leer torneos
      ".read": "auth != null",

      "$tournamentId": {
        // Solo el creador puede modificar su torneo (creación o actualización)
        // AUDIT-FIXED [2026-03-10] P1: era auth != null (cualquier usuario podía sobreescribir torneos ajenos)
        ".write": "auth != null && (!data.exists() && newData.child('creatorId').val() === auth.uid || data.child('creatorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['tournamentId', 'name', 'status', 'creatorId'])",

        "participants": {
          // B0-B [2026-03-20]: Cada participante puede escribir SOLO su propia entrada
          // El creador ya tiene acceso por la regla padre
          "$participantId": {
            ".write": "auth != null && auth.uid === $participantId"
          }
        }
      }
    },

    "notifications": {
      "$uid": {
        // Solo el usuario puede leer/escribir sus notificaciones
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "friend_requests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$requestId": {
          // Allow write if: user owns this node OR is the sender of the request
          ".write": "auth != null && (auth.uid === $uid || newData.child('senderId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['requestId', 'senderId', 'receiverId', 'status']) && (newData.child('senderId').val() === auth.uid || newData.child('receiverId').val() === auth.uid)"
        }
      }
    },

    // Paths para borrado GDPR (DeleteAccount): solo el propio usuario puede borrar sus datos
    "matchHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "achievements": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        // B0-B [2026-03-20]: Solo el dueño puede leer su lista de amigos
        // Para escritura: el dueño puede escribir cualquier entrada,
        // Y otro usuario autenticado puede escribir SOLO su propia entrada ($friendId === auth.uid)
        // Esto permite accept/reject bilateral sin Cloud Function
        "$friendId": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendId)"
        }
      }
    },

    "tournamentHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "matchmaking": {
      "$uid": {
        // Solo el usuario puede leer/escribir su propio slot de matchmaking
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "matchmaking_queue": {
      ".read": "auth != null",
      "$gameKey": {
        "$entryId": {
          // Create: only if userId matches auth. Delete: owner or opponent who claimed the match.
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || !newData.exists())",
          ".validate": "newData.hasChildren(['userId', 'userName', 'timestamp', 'status']) && newData.child('userId').val() === auth.uid && newData.child('battleCardId').exists()"
        }
      }
    },

    "active_matches": {
      ".read": "auth != null",
      "$matchId": {
        // Only match participants can write (creator sets player1Id, both update scores)
        ".write": "auth != null && (!data.exists() || data.child('player1Id').val() === auth.uid || data.child('player2Id').val() === auth.uid)",
        ".validate": "newData.hasChildren(['gameKey', 'player1Id', 'player2Id', 'status'])"
      }
    },

    "ratelimits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // CashBattle scores — server-only write (via submitCashScore Cloud Function)
    // Client can read own scores but CANNOT write (prevents score injection in real-money games)
    "cash_scores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // Bloquear acceso por defecto a cualquier otra ruta
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
