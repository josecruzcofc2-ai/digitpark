# Firebase Functions — Environment Variables
# Configurar con: firebase functions:secrets:set STRIPE_SECRET_KEY
# O con Firebase Extensions > Secret Manager

# ====== STRIPE (Solo version Pro — cosmeticos) ======
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ====== APPLE IAP ======
APPLE_SHARED_SECRET=your_shared_secret_here

# ====== ALERTS ======
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# NOTA: Firebase credentials NO son necesarias aqui —
# Firebase Admin SDK se inicializa automaticamente en Cloud Functions
# con las credenciales del proyecto.
